@using Autorisation.Models
@using AutorisationMVC.Models
@using AutorisationMVC.Services
@inject AutorisationUsers AutorisationUsers;
@page "/users" 
<div class="userPage">
    <div class="user-table">
        <div user-table-button>
            <button type="submit"  class="btn btn-primary ms-2 mb-3">Change status</button>
            <button type="submit" class="btn btn-danger ms-2 mb-3">Delete users</button>
            <button type="submit" class="btn btn-danger ms-2 mb-3">Delete unverified</button>
        </div>
        <table class="table">
            <thead class="thead-dark">
            <tr>
                <th scope="col">id</th>
                <th scope="col">Name</th>
                <th scope="col">Email</th>
                <th scope="col">Status</th>
                <th scope="col">Last login</th>
            </tr>
            </thead>
            <tbody>
            @foreach (var user in users)
            {
                <tr>
                    <th scope="row">@user.Id</th>
                    <td>@user.Name</td>
                    <td>@user.Email</td>
                    <td>@user.Status</td>
                    <td>@user.LastLogin</td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>

@code
{

    private List<Autorisations> users = new();

    protected override async Task OnInitializedAsync()
    {
        users = await AutorisationUsers.GetUsers();
    }}