@using AutorisationMVC.Models
@using AutorisationMVC.Services
@using Autorisation.Enum
@using Microsoft.AspNetCore.Authorization
@using System.Security.Claims

@attribute [Authorize]

@inject UserServices UserServices
@inject AuthenticationStateProvider AuthProvider

@page "/users"

<div class="userPage">
    <div class="user-table">

        <div class="user-table-button d-flex align-items-center gap-2 mb-3">

            <button type="button"
                    @onclick="BlockClick"
                    disabled="@(selectedIds.Count == 0)"
                    class="btn btn-primary"
                    title="Block selected users"
                    aria-label="Block selected users">
                Block
            </button>

            <button type="button"
                    @onclick="UnblockClick"
                    disabled="@(selectedIds.Count == 0)"
                    class="btn btn-primary"
                    title="Unblock selected users"
                    aria-label="Unblock selected users">

                <svg xmlns="http://www.w3.org/2000/svg"
                     width="16"
                     height="16"
                     fill="currentColor"
                     viewBox="0 0 16 16">

                    <path fill-rule="evenodd"
                          d="M12 0a4 4 0 0 1 4 4v2.5h-1V4a3 3 0 1 0-6 0v2h.5A2.5 2.5 0 0 1 12 8.5v5A2.5 2.5 0 0 1 9.5 16h-7A2.5 2.5 0 0 1 0 13.5v-5A2.5 2.5 0 0 1 2.5 6H8V4a4 4 0 0 1 4-4" />
                </svg>

            </button>

            <button type="button"
                    @onclick="DeleteUsersClick"
                    disabled="@(selectedIds.Count == 0)"
                    class="btn btn-danger"
                    title="Delete selected users"
                    aria-label="Delete selected users">

                <svg xmlns="http://www.w3.org/2000/svg"
                     width="16"
                     height="16"
                     fill="currentColor"
                     viewBox="0 0 16 16">

                    <path d="M2.5 1a1 1 0 0 0-1 1v1h13V2a1 1 0 0 0-1-1h-3l-.5-.5h-4L5.5 1z" />
                    <path d="M3 4h10l-.8 10.2a1 1 0 0 1-1 .8H4.8a1 1 0 0 1-1-.8z" />

                </svg>

            </button>

            <button type="button"
                    @onclick="DeleteStatusClick"
                    class="btn btn-danger"
                    title="Delete all unverified users"
                    aria-label="Delete all unverified users">

                <svg xmlns="http://www.w3.org/2000/svg"
                     width="16"
                     height="16"
                     fill="currentColor"
                     viewBox="0 0 16 16">

                    <path d="M1 14s-1 0-1-1 1-4 6-4 6 3 6 4-1 1-1 1z" />

                    <path fill-rule="evenodd"
                          d="M8 8a3 3 0 1 0 0-6 3 3 0 0 0 0 6m3.854 1.646a.5.5 0 0 0-.708.708L12.293 10.5l-1.147 1.146a.5.5 0 1 0 .708.708L13 11.207l1.146 1.147a.5.5 0 0 0 .708-.708L13.707 10.5l1.147-1.146a.5.5 0 0 0-.708-.708L13 9.793z" />

                </svg>

            </button>

            <input type="text"
                   placeholder="Filter"
                   @bind="filter"
                   @bind:event="oninput"
                   class="form-control filter-input" />

        </div>

        @if (!string.IsNullOrWhiteSpace(statusMessage))
        {
            <div class="alert @(statusIsSuccess ? "alert-success" : "alert-danger")"
                 role="alert">

                @statusMessage

            </div>
        }

        <table class="table user-table">

            <thead class="thead-dark">

                <tr>

                    <th scope="col">

                        <input type="checkbox"
                               id="select-all"
                               checked="@IsAllFilteredSelected"
                               @onchange="e => ToggleSelectAll(e.Value)"
                               title="Select all filtered users"
                               aria-label="Select all filtered users" />

                    </th>

                    <th scope="col">id</th>
                    <th scope="col">Name</th>
                    <th scope="col">Email</th>
                    <th scope="col">Status</th>
                    <th scope="col">Last login</th>

                </tr>

            </thead>

            <tbody>

                @foreach (var user in FilteredUsers)
                {
                    <tr @key="user.Id">

                        <td>

                            <input type="checkbox"
                                   id="@getUniqIdValue(user.Id)"
                                   checked="@selectedIds.Contains(user.Id)"
                                   @onchange="e => ToggleSelection(user.Id, e.Value)"
                                   aria-label="Select @user.Name" />

                        </td>

                        <td>@user.Id</td>
                        <td>@user.Name</td>
                        <td>@user.Email</td>
                        <td>@user.Status</td>
                        <td>@user.LastLogin</td>

                    </tr>
                }

            </tbody>

        </table>

    </div>
</div>

@code
{
    private HashSet<int> selectedIds = new();

    private List<Autorisations> users = new();

    private string filter = "";

    private string statusMessage = "";

    private bool statusIsSuccess;

    private IEnumerable<Autorisations> FilteredUsers =>
        users
            .Where(u =>
                string.IsNullOrWhiteSpace(filter) ||
                u.Name.Contains(filter, StringComparison.OrdinalIgnoreCase) ||
                u.Email.Contains(filter, StringComparison.OrdinalIgnoreCase))
            .OrderByDescending(u => u.LastLogin);

    private bool IsAllFilteredSelected
    {
        get
        {
            var filteredIds = FilteredUsers
                .Select(u => u.Id)
                .ToList();

            return filteredIds.Count > 0 &&
                   filteredIds.All(selectedIds.Contains);
        }
    }

    private string getUniqIdValue(int userId)
    {
        return $"user-checkbox-{userId}";
    }

    private void ToggleSelectAll(object? value)
    {
        var isChecked = value is bool b && b;

        var filteredIds = FilteredUsers
            .Select(u => u.Id)
            .ToHashSet();

        if (isChecked)
        {
            selectedIds.UnionWith(filteredIds);
        }
        else
        {
            selectedIds.ExceptWith(filteredIds);
        }
    }

    private async Task<int> GetCurrentUserIdAsync()
    {
        var auth = await AuthProvider.GetAuthenticationStateAsync();
        var idClaim = auth.User.FindFirst(ClaimTypes.NameIdentifier)?.Value;
        return int.TryParse(idClaim, out var id) ? id : 0;
    }
    private void ToggleSelection(int userId, object? value)
    {
        var isChecked = value is bool b && b;

        if (isChecked)
            selectedIds.Add(userId);
        else
            selectedIds.Remove(userId);
    }

    private async Task BlockClick()
    {
        if (selectedIds.Count == 0)
            return;
        var currentUserId = await GetCurrentUserIdAsync();
        var result = await UserServices.ChangeStatus(
            "blocked",
            selectedIds.ToList(),currentUserId);

        ShowResult(result);

        users = await UserServices.GetUsers();
    }

    private async Task UnblockClick()
    {
        if (selectedIds.Count == 0)
            return;
        var currentUserId = await GetCurrentUserIdAsync();
        var result = await UserServices.ChangeStatus(
            "active",
            selectedIds.ToList(), currentUserId);

        ShowResult(result);

        users = await UserServices.GetUsers();
    }

    private async Task DeleteUsersClick()
    {
        if (selectedIds.Count == 0)
            return;

        var ids = selectedIds.ToList();
        
        var currentUserId = await GetCurrentUserIdAsync();
        var result = await UserServices.DeleteUsers(ids,currentUserId);

        if (result is Microsoft.AspNetCore.Mvc.OkResult)
        {
            ShowResult(
                $"Successfully deleted {ids.Count} user(s).",
                true);

            selectedIds.Clear();
        }
        else
        {
            ShowResult(
                "Failed to delete selected users.",
                false);
        }

        users = await UserServices.GetUsers();
    }

    private async Task DeleteStatusClick()
    {
        var currentUserId = await GetCurrentUserIdAsync();
        var result = await UserServices.DeleteUnverified(currentUserId);

        ShowResult(result);

        users = await UserServices.GetUsers();

        var existingIds = users
            .Select(u => u.Id)
            .ToHashSet();

        selectedIds.IntersectWith(existingIds);
    }

    private void ShowResult(
        string message,
        bool? success = null)
    {
        statusMessage = message;

        statusIsSuccess = success ??
            message.StartsWith(
                "Successfully",
                StringComparison.OrdinalIgnoreCase);

        StateHasChanged();
    }

    protected override async Task OnInitializedAsync()
    {
        users = await UserServices.GetUsers();
    }
}