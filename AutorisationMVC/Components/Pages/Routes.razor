@using AutorisationMVC.Components.Layout
@using Microsoft.AspNetCore.Components.Routing
@using Microsoft.AspNetCore.Components.Web

<Router AppAssembly="typeof(Program).Assembly">
    <Found Context = "routeData"></Found>
    <RouteView RouteData="routeData" DefaultLayout="typeof(MainLayout)"></RouteView>
    <FocusOnNavigate RouteData="routeData"Selector="h1"></FocusOnNavigate>
<NotFound>
    <PageTitle>Не найдено</PageTitle>
    <LayoutView Layout="typeof(MainLayout)">
        <p role="alert">Извините, по этому адресу ничего нет.</p>
    </LayoutView>
</NotFound>
</Router>
