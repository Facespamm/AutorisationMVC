@inherits LayoutComponentBase
@inject NavigationManager Navigation

<div class="page">
    @if (!IsAuthPage)
    {
        <header class="bg-dark text-white py-3 mb-4">
            <div class="container d-flex justify-content-between align-items-center">
                <span class="fs-4">The App</span>
                <nav>
                    <form method="post" action="/api/auth/logout" class="d-inline">              
                        <button type="submit" class="btn btn-outline-light btn-sm">Log out</button>
                    </form>
                    <a class="text-white me-3" href="/users">Users</a>
                </nav>
            </div>
        </header>
    }

    <main>
        <div class="container py-4">
            @Body
        </div>
    </main>
</div>

@code {
    private bool IsAuthPage  =>
        Navigation.Uri.Contains("/login") || Navigation.Uri.Contains("/register");
}